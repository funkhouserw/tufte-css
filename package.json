{
  "name": "tufte-kit",
  "private": true,
  "version": "0.1.0",
  "description": "A rebuild of Tufte CSS: container queries, a cascade layer, margin notes that stay in the margin on phones, drawers, and React/MDX components.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --outDir dist --port 5181 --strictPort",
    "test": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6"
  }
}
